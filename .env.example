# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Resend: verify a sending domain before sending production email
RESEND_API_KEY=re_...
EMAIL_FROM=Diploma Project Developers <notifications@your-verified-domain.com>
NOTIFICATION_EMAIL=sirimellamahesh180@gmail.com

# Razorpay: use TEST keys first, then replace with LIVE keys after approval
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...

# Public deployment URL, e.g. https://your-project.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared rate limiting (required in production; create a free Upstash Redis database)
UPSTASH_REDIS_REST_URL=https://YOUR_DATABASE.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REST_TOKEN

# Cloudflare Turnstile (use Cloudflare test keys only for local development)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
# Optional: exact hostname expected in successful Siteverify responses (e.g. example.com)
TURNSTILE_EXPECTED_HOSTNAME=
